# Supabase project (Settings -> API in the dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service-role key: bypasses RLS. Only used server-side (edge functions),
# never shipped to a client app.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the CSRF `state` param for the WeChat/Douyin OAuth edge functions.
# Any long random string; generate with e.g. `openssl rand -hex 32`.
OAUTH_STATE_SECRET=change-me

# Google login is configured entirely in the Supabase dashboard
# (Authentication -> Providers -> Google) — no env vars needed here.

# WeChat (微信) — set as edge function secrets (`supabase secrets set`), not
# read directly by this file. Leaving these unset makes wechat-oauth
# auto-disable (returns 501) so you can ship with only Google enabled.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://xxxxxxxxxxxx.supabase.co/functions/v1/wechat-oauth/callback

# Douyin (抖音) — same as WeChat: edge function secrets, auto-disabled (501)
# when unset.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=https://xxxxxxxxxxxx.supabase.co/functions/v1/douyin-oauth/callback
